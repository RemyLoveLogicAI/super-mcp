# ──────────────────────────────────────────────
# Super-MCP Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── General ───────────────────────────────────
SMCP_ENV=development          # development | staging | production
SMCP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
SMCP_LOG_FORMAT=json          # json | console
SMCP_DATA_DIR=./data          # Persistent data directory
SMCP_SKILLS_DIR=./skills      # Skill.md artifact directory

# ── Kernel ────────────────────────────────────
SMCP_EVENT_BUS_BUFFER=10000   # Max events in ring buffer
SMCP_SAFETY_ENABLED=true      # Enable safety layer
SMCP_CHECKPOINT_DIR=./data/checkpoints

# ── OAuth Providers ───────────────────────────
# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/callback/github

# GitLab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:8080/callback/gitlab

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8080/callback/slack

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8080/callback/notion

# ── AI Providers ──────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# ── Database ──────────────────────────────────
# SQLite (default)
SMCP_DB_URL=sqlite:///./data/super-mcp.db

# PostgreSQL (optional, for production)
# SMCP_DB_URL=postgresql://user:pass@localhost:5432/super_mcp

# Redis (optional, for caching/queues)
# SMCP_REDIS_URL=redis://localhost:6379/0

# ── Observability ─────────────────────────────
SMCP_METRICS_ENABLED=true
SMCP_METRICS_PORT=9090        # Prometheus metrics endpoint
SMCP_TRACING_ENABLED=false
SMCP_TRACING_ENDPOINT=        # OpenTelemetry collector URL

# ── Security Sandbox ─────────────────────────
SMCP_SANDBOX_MEMORY_MB=256    # Max memory per sandbox
SMCP_SANDBOX_TIMEOUT_SEC=30   # Max execution time
SMCP_SANDBOX_MAX_OUTPUT_MB=1  # Max output size

# ── Server (future) ──────────────────────────
SMCP_HOST=0.0.0.0
SMCP_PORT=8080
SMCP_WORKERS=4
